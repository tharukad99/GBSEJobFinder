# UK Software Engineering Job Finder - Configuration
PROJECT_NAME="UK Software Engineering Job Finder"
API_V1_STR="/api"
ENV="development"

# Database Configuration (Azure MSSQL Server / MSSQL)
DB_SERVER=tcp:your-server.database.windows.net,1433
DB_DATABASE=bsync
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=no
DB_TRUST_SERVER_CERTIFICATE=no
DB_ENCRYPT=yes
DB_CONNECTION_TIMEOUT=30
DB_SCHEMA=job

# Scheduler Configuration (Recurring interval)
JOB_REFRESH_MINUTES=5
ENABLE_SCHEDULER=true


# Security
SECRET_KEY=supersecretkey_change_in_production_uk_se_jobs_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Defaults
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
